{
  "//": "Type-check only (no build output). Run: npx -p typescript tsc -p onboarding",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["*.ts", "*.js"]
}
